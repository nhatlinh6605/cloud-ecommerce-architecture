        <mxCell id="boundaryLbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=center;fontColor=#b85450;fontStyle=1;" value="Ranh giới tin cậy:&lt;br&gt;Internet / máy chủ" vertex="1">
